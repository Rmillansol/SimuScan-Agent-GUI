# Copy this file to `.env` and fill in your values.
#   cp .env.example .env      (or copy by hand on Windows)
# The real .env is NEVER committed to git (it is in .gitignore).

# OpenAI API key (https://platform.openai.com/api-keys)
OPENAI_API_KEY=sk-...

# Agent model. Use a full model (avoid nano/mini for multi-tool tasks).
# e.g. gpt-5.2, gpt-5.5, gpt-4o
OPENAI_MODEL=gpt-5.2

# Reference-image generation model. e.g. gpt-image-1, gpt-image-2
OPENAI_IMAGE_MODEL=gpt-image-1

# Working directory (optional)
WORKING_DIR=C:\data\simuscan
